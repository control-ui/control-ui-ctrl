{
    "name": "@ui-controls/progress",
    "version": "0.2.0",
    "description": "Material-UI Buttons with progress (loading/error/success) and click-to-confirm colors and interaction flow.",
    "homepage": "https://github.com/control-ui/control-ui-ctrl/tree/main/packages/ctrls-progress",
    "author": "Michael Becker <michael@bemit.codes> (https://bemit.codes)",
    "license": "MIT",
    "keywords": [
        "mui",
        "material",
        "material-ui",
        "react",
        "reactjs",
        "react-component",
        "ui",
        "control"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/control-ui/control-ui-ctrl.git",
        "directory": "packages/ctrls-progress"
    },
    "bugs": {
        "url": "https://github.com/control-ui/control-ui-ctrl/issues"
    },
    "main": "index.cjs",
    "module": "esm/index.js",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./esm/index.js",
            "require": "./index.cjs"
        },
        "./*": {
            "types": "./*/index.d.ts",
            "import": "./esm/*/index.js",
            "require": "./*/index.cjs"
        },
        "./package.json": "./package.json",
        "./esm": null
    },
    "scripts": {
        "dtsgen": "tsc -d --emitDeclarationOnly --pretty && node ../../tools/merge-dirs build/dts/packages/ctrls-progress/src build && rm -rf build/dts && rm -rf build/**/*.test.* build/**/*.mock.*",
        "__release": "cp package.json build/ && cp package-lock.json build/ && cp README.md build/ && npm publish build"
    },
    "sideEffects": false,
    "dependencies": {
    },
    "devDependencies": {
        "@types/react": "^19.0",
        "@types/react-dom": "^19.0",
        "@mui/material": "^7.1.2",
        "@mui/icons-material": "^7.1.2",
        "@emotion/react": "^11.9.0",
        "@emotion/styled": "^11.8.1",
        "react": "^19.0",
        "react-progress-state": "~0.4.0",
        "react-dom": "^19.0"
    },
    "peerDependencies": {
        "@mui/material": "^5.1 || ^6.1 || ^7.1",
        "react-progress-state": "~0.4.0",
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19"
    },
    "publishConfig": {
        "access": "public"
    }
}
